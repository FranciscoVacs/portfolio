# Token de GitHub para el calendario de contribuciones del home.
#
# Scope necesario: read:user (personal access token clásico). Sin este token
# el sitio funciona igual, pero el calendario solo cuenta las contribuciones
# de repositorios públicos.
#
# En Vercel se carga en Project Settings > Environment Variables. Nunca se
# commitea: el valor real va en .env.local, que está ignorado por git.
GITHUB_CONTRIBUTIONS_TOKEN=
